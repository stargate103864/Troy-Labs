#BlueJ class context
comment0.target=Picture
comment0.text=\r\n\ A\ class\ that\ represents\ a\ picture.\ \ This\ class\ inherits\ from\ \r\n\ SimplePicture\ and\ allows\ the\ student\ to\ add\ functionality\ to\r\n\ the\ Picture\ class.\ \ \r\n\ \r\n\ @author\ Barbara\ Ericson\ ericson@cc.gatech.edu\r\n
comment1.params=
comment1.target=Picture()
comment1.text=\r\n\ Constructor\ that\ takes\ no\ arguments\ \r\n
comment10.params=
comment10.target=void\ grayscale()
comment10.text=\ \r\n\ \ \ \ turn\ the\ picture\ into\ shades\ of\ gray.\r\n\ \ \ \ Set\ the\ red,\ green,\ and\ blue\ values\ to\ the\ average\ of\ the\ current\ red,\ green,\ and\ blue\ values\r\n\ \ \ \ (add\ all\ three\ values\ and\ divide\ by\ 3)\r\n
comment11.params=
comment11.target=void\ mirrorVertical()
comment11.text=\r\n\ \ \ Method\ that\ mirrors\ the\ picture\ around\ a\ \r\n\ \ \ vertical\ mirror\ in\ the\ center\ of\ the\ picture\r\n\ \ \ from\ left\ to\ right\r\n
comment12.params=
comment12.target=void\ mirrorVerticalRightToLeft()
comment12.text=\r\n\ \ \ Method\ that\ mirrors\ the\ picture\ around\ a\ \r\n\ \ \ vertical\ mirror\ in\ the\ center\ of\ the\ picture\r\n\ \ \ from\ right\ to\ left\r\n
comment13.params=
comment13.target=void\ mirrorHorizontal()
comment13.text=\r\n\ \ \ Method\ that\ mirrors\ the\ picture\ around\ a\ mirror\r\n\ \ \ placed\ horizontally\ at\ the\ middle\ of\ the\ height\ of\ the\ picture\r\n\ \ \ \r\n\ \ \ Top\ half\ copied\ to\ bottom\ half\r\n
comment14.params=fromPic\ startRow\ startCol
comment14.target=void\ copy(Picture,\ int,\ int)
comment14.text=\ copy\ from\ the\ passed\ fromPic\ to\ the\r\n\ specified\ startRow\ and\ startCol\ in\ the\r\n\ current\ picture\r\n\ @param\ fromPic\ the\ picture\ to\ copy\ from\r\n\ @param\ startRow\ the\ start\ row\ to\ copy\ to\r\n\ @param\ startCol\ the\ start\ col\ to\ copy\ to\r\n
