comment8.text=\ \r\n\ \ \ \ postconditin\:\r\n\ \ \ \ \ \ \ Set\ red\ and\ green\ value\ to\ zero.\r\n\ \ \ \ \ \ \ Blue\ value\ has\ not\ been\ changed\r\n
comment9.params=
comment9.target=void\ negatePixels()
comment9.text=\ \r\n\ \ \ \ negate\ all\ the\ pixels\ in\ a\ picture\r\n\ \ \ \ To\ negate\ a\ picture,\ set\ the\ red\ value\ to\ 255\ minus\ the\ current\ red\ value\r\n\ \ \ \ \ \ \ \ \ \ \ \ \ \ \ \ \ \ \ \ \ \ \ \ \ set\ the\ green\ value\ to\ 255\ minus\ the\ current\ green\ value\r\n\ \ \ \ \ \ \ \ \ \ \ \ \ \ \ \ \ \ \ \ \ \ \ \ \ and\ set\ the\ blue\ value\ to\ 255\ minus\ the\ current\ blue\ value\r\n
